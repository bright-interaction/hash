# Hash configuration template. Copy to .env (or your orchestrator's secret
# store) and fill in; never commit real .env files. See DEPLOY.md for the full
# deployment guide.
#
# Markers below:
#   [required]      boot fails without it (every environment)
#   [required-prod] boot fails without it outside local dev (loopback / *.local)
#   [optional]      feature stays off / falls back to the shown default when unset
# Every var is read in internal/config/config.go.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
HASH_PORT=8080
# [required] Public base URL. Loopback / *.local hosts enable dev mode, which
# relaxes the production-only guards below.
HASH_PUBLIC_URL=https://esign.example.com
HASH_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (Postgres)  [required]
# ---------------------------------------------------------------------------
HASH_DB_URL=postgres://hash:changeme@postgres:5432/hash?sslmode=disable

# ---------------------------------------------------------------------------
# Object storage (MinIO / S3)
# ---------------------------------------------------------------------------
HASH_S3_ENDPOINT=s3.example.com   # [required]
HASH_S3_REGION=eu-central-1                  # [optional] default eu-central-1
HASH_S3_BUCKET=hash                       # [optional] default hash
HASH_S3_ACCESS_KEY=changeme                  # [required]
HASH_S3_SECRET_KEY=changeme                  # [required]
HASH_S3_USE_SSL=true                         # [optional] default true

# ---------------------------------------------------------------------------
# SMTP (outbound email; drained by the worker's email-dispatch loop)
# [optional] unset = NoopMailer (no mail sent); queue still records messages.
# ---------------------------------------------------------------------------
HASH_SMTP_HOST=mail.example.com
HASH_SMTP_PORT=587
HASH_SMTP_USER=hash@example.com
HASH_SMTP_PASSWORD=changeme
HASH_SMTP_FROM=Hash <esign@example.com>

# ---------------------------------------------------------------------------
# Zitadel OIDC (sender authentication)  [required]
# ---------------------------------------------------------------------------
HASH_OIDC_ISSUER=https://auth.example.com
HASH_OIDC_CLIENT_ID=changeme
HASH_OIDC_CLIENT_SECRET=changeme
HASH_OIDC_REDIRECT_URL=https://esign.example.com/auth/callback

# ---------------------------------------------------------------------------
# Cryptographic keys
# ---------------------------------------------------------------------------
# [required] 32 random bytes hex-encoded (64 hex chars) for HMAC of magic-link
# signer tokens. Rejected if < 32 chars or all-identical. Generate:
#   openssl rand -hex 32
HASH_SIGNER_TOKEN_KEY=changeme_64_hex_chars_for_hmac_of_signer_magic_link_tokens_aaaa
# [required] 32-byte session-cookie key, hex-encoded (same entropy rules).
HASH_SESSION_KEY=changeme_64_hex_chars_for_session_cookie_signing_a_a_a_a_a_a_aa
# [required-prod] ed25519 private key (base64) for signing audit certificates.
# Without a stable key, certs signed before a restart can't be verified. The
# server + worker MUST share the same key. Generate:
#   openssl genpkey -algorithm ed25519 -outform DER | base64
HASH_AUDIT_PRIVATE_KEY=changeme_base64_encoded_ed25519_private_key

# ---------------------------------------------------------------------------
# Webhooks (outbound, HMAC-signed; rotate periodically via your secrets tooling)
# ---------------------------------------------------------------------------
HASH_WEBHOOK_SECRET=changeme          # [optional] signs outbound webhook bodies
HASH_WEBHOOK_SECRET_PREVIOUS=         # [optional] previous secret during rotation
# [optional] bearer token for the admin secret hot-reload endpoint.
HASH_ADMIN_RELOAD_TOKEN=changeme

# ---------------------------------------------------------------------------
# Gotenberg (HTML -> PDF renderer)
# ---------------------------------------------------------------------------
HASH_GOTENBERG_URL=http://gotenberg:3000   # [optional] default http://gotenberg:3000

# ---------------------------------------------------------------------------
# Variable-resolver integrations (Phase 8.2). [optional] empty = source off.
# ---------------------------------------------------------------------------
HASH_BRIGHTCRM_URL=
HASH_BRIGHTCRM_TOKEN=
# [required-prod when BRIGHTCRM_URL set] >= 32 chars; verifies the inbound
# /webhooks/brightcrm HMAC so cache-invalidation can't be spoofed org-wide.
HASH_BRIGHTCRM_WEBHOOK_SECRET=
HASH_SCANNER_URL=
HASH_SCANNER_TOKEN=

# ---------------------------------------------------------------------------
# AI runtime (Phase 8.4). All [optional]; empty provider key = provider off.
# In production, if ANY provider key is set: Shield MUST be enabled (64-hex
# key) AND the provider base URL host MUST be on the EU allow-list, or boot
# fails (PII never reaches a non-EU LLM endpoint).
# ---------------------------------------------------------------------------
# 64 hex chars (32 bytes). Tokenizes PII before any LLM call; also encrypts
# per-org BYOAI keys at rest. Generate: openssl rand -hex 32
HASH_AI_SHIELD_KEY=
HASH_AI_DEFAULT_PROVIDER=mistral       # [optional] mistral (default) | anthropic
HASH_MISTRAL_BASE_URL=                 # default api.mistral.ai (EU)
HASH_MISTRAL_API_KEY=
HASH_MISTRAL_MODEL=
HASH_ANTHROPIC_BASE_URL=               # must resolve to eu.anthropic.com in prod
HASH_ANTHROPIC_API_KEY=
HASH_ANTHROPIC_MODEL=
# Comma-separated extra EU-compliant hostnames/suffixes (e.g. a self-hosted
# LLM in the VPC). Built-ins: api.mistral.ai, eu.anthropic.com, eu.openrouter.ai.
HASH_AI_EU_HOSTS_ALLOWLIST=

# ---------------------------------------------------------------------------
# QES (qualified signatures via a QTSP). [required-prod] provider must be real.
# ---------------------------------------------------------------------------
# 'mock' auto-completes signatures with NO verification (dev/e2e only). Prod
# must be a real QTSP, e.g. 'idura'.
HASH_QES_PROVIDER=mock
HASH_QES_IDURA_BASE_URL=https://api.idura.se   # [optional] default shown
HASH_QES_IDURA_API_KEY=                        # [required-prod when provider=idura]
HASH_QES_IDURA_TENANT=
# [optional] JSON file of curated QTSP-root SHA-256 fingerprints. Empty disables
# chain validation; a non-empty but missing path is a hard boot error.
HASH_QES_TRUST_LIST_PATH=

# ---------------------------------------------------------------------------
# Evidence bundle OpenTimestamps anchoring (Phase 10.2). [optional]
# ---------------------------------------------------------------------------
HASH_EVIDENCE_OTS_ENABLED=false
HASH_EVIDENCE_OTS_ENDPOINT=

# ---------------------------------------------------------------------------
# Compliance feed (Phase 12.2). [optional] empty = EDPB rollup loop off.
# ---------------------------------------------------------------------------
HASH_COMPLIANCE_FEED_URL=

# ---------------------------------------------------------------------------
# Billing (Mollie). [required-prod] provider must be 'mollie'.
# ---------------------------------------------------------------------------
# 'mock' accepts unauthenticated webhooks (dev/e2e only).
HASH_BILLING_PROVIDER=mock
HASH_MOLLIE_API_KEY=                                  # [required-prod when provider=mollie]
HASH_MOLLIE_BASE_URL=https://api.mollie.com/v2        # [optional] default shown
# [required-prod when provider=mollie] >= 16 chars; embedded in the webhook URL
# so /webhooks/billing/<secret> is unguessable.
HASH_MOLLIE_WEBHOOK_PATH_SECRET=
